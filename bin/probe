#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the driver for GREETER_CHANNEL through the composition root and reports
# whether the channel is reachable and which versions it reports. It greets an
# empty name, which every channel rejects without changing anything, so probing
# never greets a guest or changes a count. Prints JSON:
#   { "channel": "http", "reachable": true,
#     "build_info": { "channel_version": "v1.2.3", "core_version": "0.1.5" } }
# build_info is null when the channel does not report its versions. Exits 0 when
# the channel is reachable and 1 when the probe hit an infrastructure error.
#
# The same environment variables as the suite: GREETER_CHANNEL, GREETER_CLI_CMD,
# GREETER_CLI_DIR, GREETER_BASE_URL.

require 'json'

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'greeter_acceptance/composition_root'

begin
  driver = GreeterAcceptance::CompositionRoot.build_driver
rescue GreeterAcceptance::CompositionRoot::ConfigurationError => e
  abort "bin/probe: #{e.message}"
end

reachable = driver.greet('').outcome != :infrastructure_error
info = driver.build_info
puts JSON.pretty_generate(
  'channel' => driver.channel.to_s, 'reachable' => reachable,
  'build_info' => info && { 'channel_version' => info.channel_version, 'core_version' => info.core_version }
)
exit 1 unless reachable
